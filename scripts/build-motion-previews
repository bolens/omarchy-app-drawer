#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source_image="$repo_root/screenshots/expanded.png"
output_dir="$repo_root/docs/motion"
work_dir=$(mktemp -d /tmp/app-drawer-motion.XXXXXX)
trap 'rm -r "$work_dir"' EXIT

command -v magick >/dev/null || { printf '%s\n' 'ImageMagick is required.' >&2; exit 1; }
mkdir -p "$output_dir"

# The drawer glyph occupies the final 80 px. The fourteen 80 px slots before it
# follow Model.revealExtent() and Model.revealOpacity() from right to left.
magick "$source_image" -fill '#000000' -draw 'rectangle 0,34 1119,98' "$work_dir/base.png"
progress=(0 8 17 25 33 42 50 58 67 75 83 92 100 100 100 100 92 83 75 67 58 50 42 33 25 17 8 0 0 0)

render_frame() {
  local style=$1 frame=$2 p=$3 command=(magick "$work_dir/base.png")
  local slot x trailing visible alpha local_progress smooth
  for slot in {0..13}; do
    x=$((slot * 80))
    trailing=$((1120 - x - 80))
    visible=$((1120 * p / 100 - trailing))
    (( visible < 0 )) && visible=0
    (( visible > 80 )) && visible=80
    (( visible == 0 )) && continue
    alpha=100
    case "$style" in
      cascade)
        local_progress=$(((p * 1120 / 100 - trailing) * 100 / 202))
        (( local_progress < 0 )) && local_progress=0
        (( local_progress > 100 )) && local_progress=100
        smooth=$((local_progress * local_progress * (300 - 2 * local_progress) / 10000))
        alpha=$smooth
        ;;
      soft-cascade) alpha=$((25 + 75 * visible / 80)) ;;
      uniform) alpha=$((p == 0 ? 0 : 20 + 80 * p / 100)) ;;
    esac
    command+=("(" "$source_image" -crop "${visible}x64+$((x + 80 - visible))+34" +repage ")")
    if (( alpha < 100 )); then command+=(-channel A -evaluate multiply "$alpha%" +channel); fi
    command+=(-geometry "+$((x + 80 - visible))+34" -composite)
  done
  "${command[@]}" "$work_dir/${style}-${frame}.png"
}

for style in taskbar cascade soft-cascade uniform; do
  frames=()
  for index in "${!progress[@]}"; do
    printf -v frame '%02d' "$index"
    render_frame "$style" "$frame" "${progress[$index]}"
    frames+=("$work_dir/${style}-${frame}.png")
  done
  magick -delay 4 -loop 0 "${frames[@]}" -quality 82 "$output_dir/$style.webp"
done

magick -delay 55 -loop 0 "$work_dir/base.png" "$source_image" "$output_dir/instant.webp"
printf 'Built motion previews in %s\n' "$output_dir"
