#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [--monitor NAME] [--workspace ID] (--verify | --audit-dir DIR) [--report FILE]\n' "${0##*/}"
}

monitor=""
capture_workspace=""
audit_dir=""
report=""
verify=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --monitor) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; monitor=$2; shift 2 ;;
    --workspace) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; capture_workspace=$2; shift 2 ;;
    --audit-dir) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; audit_dir=$2; shift 2 ;;
    --report) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; report=$2; shift 2 ;;
    --verify) verify=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[[ $verify == true || -n $audit_dir ]] || { usage >&2; exit 2; }
[[ $verify != true || -z $audit_dir ]] || { printf '%s\n' '--verify and --audit-dir cannot be combined.' >&2; exit 2; }
[[ -z $capture_workspace || $capture_workspace =~ ^[1-9][0-9]*$ ]] || { printf '%s\n' '--workspace must be a positive integer.' >&2; exit 2; }

for command in ffprobe grim hyprctl jq qs wf-recorder; do
  command -v "$command" >/dev/null || { printf 'Missing command: %s\n' "$command" >&2; exit 1; }
done

if [[ $verify == true ]]; then
  output_dir=$(mktemp -d /tmp/app-drawer-capture.XXXXXX)
  remove_output=true
else
  [[ $audit_dir == /tmp/* ]] || { printf '%s\n' '--audit-dir must be below /tmp.' >&2; exit 2; }
  mkdir -p "$audit_dir"
  [[ -z $(find "$audit_dir" -mindepth 1 -maxdepth 1 -print -quit) ]] || { printf 'Audit directory is not empty: %s\n' "$audit_dir" >&2; exit 2; }
  output_dir=$audit_dir
  remove_output=false
fi

lock_file=/tmp/omarchy-app-drawer-capture.lock
exec 9>"$lock_file"
flock -n 9 || { printf '%s\n' 'Another App Drawer capture is running.' >&2; exit 1; }

shell_pid=""
while read -r candidate; do
  probe=$(qs ipc --pid "$candidate" call app-drawer status 2>/dev/null || true)
  if jq -e '.ipcVersion == 1 and (.presentations | type == "array")' <<<"$probe" >/dev/null 2>&1; then
    shell_pid=$candidate
    break
  fi
done < <(qs list --all | awk '/Process ID:/{print $3}')
[[ -n $shell_pid ]] || { printf '%s\n' 'No IPC-ready App Drawer shell found.' >&2; exit 1; }

call() { qs ipc --pid "$shell_pid" call app-drawer "$@"; }
initial_status=$(call status)
initial_inventory=$(qs list --all | awk '/Process ID:|Config path:/{sub(/^[[:space:]]+/,"");print}' | sort)
monitors=$(call registeredMonitors)
if [[ -z $monitor ]]; then monitor=$(jq -r '.[0] // ""' <<<"$monitors"); fi
jq -e --arg monitor "$monitor" 'index($monitor) != null' <<<"$monitors" >/dev/null ||
  { printf 'App Drawer is not registered on %s.\n' "$monitor" >&2; exit 1; }
[[ $monitor =~ ^[A-Za-z0-9._:-]+$ ]] || { printf 'Unsafe monitor name: %s\n' "$monitor" >&2; exit 1; }

monitor_json=$(hyprctl monitors -j | jq -c --arg monitor "$monitor" '.[] | select(.name==$monitor)')
[[ -n $monitor_json ]] || { printf 'Hyprland monitor is not attached: %s\n' "$monitor" >&2; exit 1; }
geometry=$(jq -r '"\(.x),\(.y) \(.width)x64"' <<<"$monitor_json")
initial_workspace=$(jq -r '.activeWorkspace.id' <<<"$monitor_json")
initial_focused_monitor=$(hyprctl monitors -j | jq -r '.[]|select(.focused)|.name')
workspace_snapshot=$(hyprctl workspaces -j)
if [[ -z $capture_workspace ]]; then
  capture_workspace=$(jq -r --arg monitor "$monitor" --argjson initial "$initial_workspace" '[.[]|select(.monitor==$monitor and .windows==0 and .id>0 and .id!=$initial)|.id]|sort|.[0] // empty' <<<"$workspace_snapshot")
fi
[[ -n $capture_workspace ]] || { printf 'No empty workspace is available on %s.\n' "$monitor" >&2; exit 1; }
jq -e --arg monitor "$monitor" --argjson workspace "$capture_workspace" 'any(.[];.id==$workspace and .monitor==$monitor and .windows==0)' <<<"$workspace_snapshot" >/dev/null ||
  { printf 'Capture workspace %s is not empty on %s.\n' "$capture_workspace" "$monitor" >&2; exit 1; }
initial_appearance=$(jq -c '.appearance' <<<"$initial_status")
initial_states=$(jq -c '.monitorStates' <<<"$initial_status")
initial_modes=$(jq -c '.monitorModes' <<<"$initial_status")
initial_open_monitor=""
initial_open_page=""
while read -r candidate; do
  panel=$(call settingsStatusFor "$candidate")
  if [[ $(jq -r '.open' <<<"$panel") == true ]]; then
    initial_open_monitor=$candidate
    initial_open_page=$(jq -r '.page' <<<"$panel")
    break
  fi
done < <(jq -r '.[]' <<<"$monitors")

recorder_pid=""
workspace_switched=false
restore() {
  local screen expanded mode
  [[ -z $recorder_pid ]] || { kill -INT "$recorder_pid" 2>/dev/null || true; wait "$recorder_pid" 2>/dev/null || true; recorder_pid=""; }
  call closeSettings >/dev/null 2>&1 || true
  call setAppearance "$initial_appearance" >/dev/null 2>&1 || true
  while IFS=$'\t' read -r screen expanded; do call setMonitorExpanded "$screen" "$expanded" >/dev/null 2>&1 || true; done < <(jq -r 'to_entries[]|[.key,.value]|@tsv' <<<"$initial_states")
  while IFS=$'\t' read -r screen mode; do call setMonitorMode "$screen" "$mode" >/dev/null 2>&1 || true; done < <(jq -r 'to_entries[]|[.key,.value]|@tsv' <<<"$initial_modes")
  if [[ $workspace_switched == true ]]; then
    hyprctl dispatch "hl.dsp.focus({ monitor = \"$monitor\" })" >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.focus({ workspace = \"$initial_workspace\" })" >/dev/null 2>&1 || true
    [[ -z $initial_focused_monitor ]] || hyprctl dispatch "hl.dsp.focus({ monitor = \"$initial_focused_monitor\" })" >/dev/null 2>&1 || true
    workspace_switched=false
  fi
  if [[ -n $initial_open_monitor ]]; then
    if [[ $initial_open_page == appearance ]]; then call openMonitorAppearance "$initial_open_monitor" >/dev/null 2>&1 || true
    else call openMonitorSettings "$initial_open_monitor" >/dev/null 2>&1 || true
    fi
  fi
}
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  set +e
  restore
  if [[ $remove_output == true ]]; then rm -r "$output_dir"; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

workspace_switched=true
hyprctl dispatch "hl.dsp.focus({ monitor = \"$monitor\" })" >/dev/null
hyprctl dispatch "hl.dsp.focus({ workspace = \"$capture_workspace\" })" >/dev/null

wait_for_idle() {
  local expected=$1 status
  for _attempt in {1..100}; do
    status=$(call status)
    if jq -e --arg monitor "$monitor" --argjson expected "$expected" '
      .monitorStates[$monitor] == $expected and
      ([.presentations[] | select(.screen==$monitor) | .running] | all(.==false))
    ' <<<"$status" >/dev/null; then return 0; fi
    sleep 0.02
  done
  printf 'Drawer did not settle to expanded=%s on %s.\n' "$expected" "$monitor" >&2
  return 1
}

capture_png() { grim -g "$geometry" "$output_dir/$1.png"; }
capture_monitor() { grim -o "$monitor" "$output_dir/$1.png"; }
wait_for_scroll() {
  local position=$1 status
  for _attempt in {1..60}; do
    status=$(call settingsStatusFor "$monitor")
    if [[ $position == top ]] && jq -e '.scrollY <= 1' <<<"$status" >/dev/null; then return 0; fi
    if [[ $position == bottom ]] && jq -e '.scrollY >= (.scrollMaximum - 1)' <<<"$status" >/dev/null; then return 0; fi
    sleep 0.03
  done
  printf 'Settings panel did not reach %s.\n' "$position" >&2
  return 1
}
call closeSettings >/dev/null 2>&1 || true
call setMonitorExpanded "$monitor" false >/dev/null
wait_for_idle false
capture_png collapsed
call setMonitorExpanded "$monitor" true >/dev/null
wait_for_idle true
capture_png expanded
call openMonitorAppearance "$monitor" >/dev/null
for _attempt in {1..60}; do
  panel=$(call settingsStatusFor "$monitor")
  [[ $(jq -r '.open and .viewportHeight > 0 and .renderedRows > 1' <<<"$panel") == true ]] && break
  sleep 0.05
done
[[ $(jq -r '.open and .viewportHeight > 0 and .renderedRows > 1' <<<"$panel") == true ]] ||
  { printf '%s\n' 'Appearance panel did not render.' >&2; exit 1; }
call scrollSettingsFor "$monitor" top >/dev/null
wait_for_scroll top
capture_monitor appearance
call scrollSettingsFor "$monitor" bottom >/dev/null
wait_for_scroll bottom
capture_monitor appearance-bottom
call closeSettings >/dev/null

for style in taskbar cascade softCascade uniform instant; do
  call setAppearance "$(jq -cn --arg style "$style" '{animationEnabled:true,animationDuration:250,animationStyle:$style}')" >/dev/null
  call setMonitorExpanded "$monitor" false >/dev/null
  wait_for_idle false
  recorder_log=$(mktemp /tmp/app-drawer-recorder.XXXXXX)
  wf-recorder -y -D -g "$geometry" -r 60 -c libvpx-vp9 -f "$output_dir/animation-$style.webm" >"$recorder_log" 2>&1 &
  recorder_pid=$!
  sleep 0.15
  if ! kill -0 "$recorder_pid" 2>/dev/null; then
    wait "$recorder_pid" || true
    sed -n '1,120p' "$recorder_log" >&2
    printf 'Animation recorder failed to start: %s\n' "$style" >&2
    exit 1
  fi
  call setMonitorExpanded "$monitor" true >/dev/null
  wait_for_idle true
  call setMonitorExpanded "$monitor" false >/dev/null
  wait_for_idle false
  sleep 0.15
  kill -INT "$recorder_pid"
  wait "$recorder_pid"
  recorder_pid=""
  rm -f "$recorder_log"
  [[ $(stat -c %s "$output_dir/animation-$style.webm") -gt 1024 ]] || { printf 'Animation capture is empty: %s\n' "$style" >&2; exit 1; }
  frame_count=$(ffprobe -v error -count_frames -select_streams v:0 \
    -show_entries stream=nb_read_frames -of default=nokey=1:noprint_wrappers=1 \
    "$output_dir/animation-$style.webm")
  [[ $frame_count =~ ^[0-9]+$ && $frame_count -ge 10 ]] || {
    printf 'Animation capture has too few frames (%s): %s\n' "$frame_count" "$style" >&2
    exit 1
  }
done

restore
after_inventory=$(qs list --all | awk '/Process ID:|Config path:/{sub(/^[[:space:]]+/,"");print}' | sort)
[[ $after_inventory == "$initial_inventory" ]] || { printf '%s\n' 'Persistent Quickshell inventory changed during capture.' >&2; exit 1; }
[[ $(call status | jq -c '.appearance') == "$initial_appearance" ]] || { printf '%s\n' 'Appearance restoration failed.' >&2; exit 1; }

if [[ -n $report ]]; then
  jq -n --arg plugin app-drawer --arg monitor "$monitor" --arg output "$output_dir"     --argjson files "$(find "$output_dir" -maxdepth 1 -type f -printf '%f\n' | sort | jq -Rsc 'split("\n")[:-1]')"     '{plugin:$plugin,monitor:$monitor,output:$output,files:$files,restored:true}' > "$report"
fi
printf 'App Drawer visual capture passed for %s.\n' "$monitor"
